SQ_APP_BASE_URL = https:/$()/signalquest.fr
SQ_API_BASE_URL = https:/$()/api.signalquest.fr
SQ_DEBUG_LOGS = NO
SQ_APS_ENVIRONMENT = production
SQ_ENVIRONMENT = production
SQ_DISPLAY_NAME = SignalQuest
SQ_APP_GROUP = group.fr.signalquest.ios
SQ_NOTIFICATION_KEYCHAIN_GROUP = fr.signalquest.ios.notifications
SQ_ASSOCIATED_DOMAIN = webcredentials:signalquest.fr
// Liens universels : le lien de partage Sentinelle ouvre l'app, pas Safari.
// Chemins revendiqués côté serveur, dans .well-known/apple-app-site-association.
SQ_APPLINKS_DOMAIN = applinks:signalquest.fr
SQ_URL_SCHEME = signalquest
// Fichier d'entitlements de la cible app (project.yml lit $(SQ_ENTITLEMENTS)).
// Contient l'entitlement CarPlay « driving task » accordé par Apple (12892a96),
// présent dans le profil App Store. Une clé absente du profil ferait échouer la
// signature, même si la capacité existe dans le code.
SQ_ENTITLEMENTS = SignalQuestApp/SignalQuest.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS =
