SQ_APP_BASE_URL = https:/$()/signalquest.fr
SQ_API_BASE_URL = https:/$()/api.signalquest.fr
SQ_DEBUG_LOGS = YES
SQ_APS_ENVIRONMENT = development
SQ_ENVIRONMENT = development
SQ_DISPLAY_NAME = SignalQuest
SQ_APP_GROUP = group.fr.signalquest.ios
SQ_NOTIFICATION_KEYCHAIN_GROUP = fr.signalquest.ios.notifications
SQ_ASSOCIATED_DOMAIN = webcredentials:signalquest.fr
// Liens universels : le lien de partage Sentinelle ouvre l'app, pas Safari.
// Chemins revendiqués côté serveur, dans .well-known/apple-app-site-association.
SQ_APPLINKS_DOMAIN = applinks:signalquest.fr
SQ_URL_SCHEME = signalquest
// Fichier d'entitlements de la cible app (project.yml lit $(SQ_ENTITLEMENTS)).
// Le fichier partagé reste limité aux entitlements réellement présents dans les
// profils de signature. Pour tester CarPlay au simulateur, Local.xcconfig peut
// pointer vers un fichier d'entitlements local non suivi (voir .gitignore).
SQ_ENTITLEMENTS = SignalQuestApp/SignalQuest.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG

// Surcharges propres au poste, git-ignorées. Le `?` rend l'inclusion
// facultative : l'absence du fichier n'est pas une erreur, et rien ne change
// pour qui n'en a pas. Placé EN DERNIER — en xcconfig, la dernière définition
// d'une variable gagne, donc un include placé plus haut serait sans effet.
#include? "Local.xcconfig"
