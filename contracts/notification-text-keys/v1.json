{
  "contract": "hors-france-contract-r1.md §1 (NOTIF-I18N)",
  "version": 1,
  "frozen": "2026-11-12",
  "note": "Gabarits fr : référence (le ton tu/vous est choisi par l'app avec addressForm). Une clé désigne un titre fixe (title) et un corps (fr) ; la variante _group garde le titre de sa clé de base. Entrée : type, metadata décodée, message (lu seulement pour l'historique : émoji d'une réaction, nom d'un badge). Sortie : textKey/textArgs servis ; null veut dire : afficher title et message.",
  "keys": [
    {
      "key": "notif.social.reaction_heart",
      "args": {
        "actorName": "string"
      },
      "title": "Réaction à ta publication",
      "fr": "{actorName} a aimé ta publication."
    },
    {
      "key": "notif.social.reaction_emoji",
      "args": {
        "actorName": "string",
        "emoji": "string"
      },
      "title": "Réaction à ta publication",
      "fr": "{actorName} a réagi {emoji} à ta publication."
    },
    {
      "key": "notif.social.reaction_group",
      "args": {
        "actorName": "string",
        "otherCount": "integer"
      },
      "title": "Réaction à ta publication",
      "fr": "{actorName} et {otherCount} autres ont réagi à ta publication."
    },
    {
      "key": "notif.social.comment",
      "args": {
        "actorName": "string"
      },
      "title": "Nouveau commentaire",
      "fr": "{actorName} a commenté ta publication."
    },
    {
      "key": "notif.social.comment_group",
      "args": {
        "actorName": "string",
        "otherCount": "integer"
      },
      "title": "Nouveau commentaire",
      "fr": "{actorName} et {otherCount} autres ont commenté ta publication."
    },
    {
      "key": "notif.social.reply",
      "args": {
        "actorName": "string"
      },
      "title": "Nouvelle réponse",
      "fr": "{actorName} a répondu à ton commentaire."
    },
    {
      "key": "notif.social.reply_group",
      "args": {
        "actorName": "string",
        "otherCount": "integer"
      },
      "title": "Nouvelle réponse",
      "fr": "{actorName} et {otherCount} autres ont répondu à ton commentaire."
    },
    {
      "key": "notif.social.repost",
      "args": {
        "actorName": "string"
      },
      "title": "Publication repartagée",
      "fr": "{actorName} a repartagé ta publication."
    },
    {
      "key": "notif.social.repost_group",
      "args": {
        "actorName": "string",
        "otherCount": "integer"
      },
      "title": "Publication repartagée",
      "fr": "{actorName} et {otherCount} autres ont repartagé ta publication."
    },
    {
      "key": "notif.social.mention",
      "args": {
        "actorName": "string"
      },
      "title": "Tu as été mentionné",
      "fr": "{actorName} t'a mentionné dans le réseau social."
    },
    {
      "key": "notif.social.mention_group",
      "args": {
        "actorName": "string",
        "otherCount": "integer"
      },
      "title": "Tu as été mentionné",
      "fr": "{actorName} et {otherCount} autres t'ont mentionné."
    },
    {
      "key": "notif.social.follow",
      "args": {
        "actorName": "string"
      },
      "title": "Nouvel abonné",
      "fr": "{actorName} suit maintenant ton profil public."
    },
    {
      "key": "notif.progress.badge",
      "args": {
        "badgeId": "string",
        "badgeName": "string"
      },
      "title": "Nouveau badge",
      "fr": "Badge « {badgeName} » obtenu."
    },
    {
      "key": "notif.progress.level",
      "args": {
        "newLevel": "integer"
      },
      "title": "Niveau {newLevel}",
      "fr": "Vous passez au niveau {newLevel}."
