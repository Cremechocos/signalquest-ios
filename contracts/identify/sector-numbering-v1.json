{
  "contract": "sector-numbering-v1",
  "decidedOn": "2026-11-14",
  "rules": {
    "northFirstSfrOnBouyguesLedCrozon": {
      "scope": "operator SFR, sharingType crozon, crozonLeader BOUYGUES (toutes technos)",
      "effect": "les azimuts des secteurs physiques sont ordonnés à partir de celui qui est le plus près du nord, puis dans le sens croissant ; le numéro de secteur ((cellId mod N) + 1, base 1) ne change pas, seul le cône désigné change"
    },
    "bouyguesNrOnSfrLedCrozon": {
      "scope": "operator BOUYGUES, tech 5G, sharingType crozon, crozonLeader SFR",
      "effect": "cellId local dans [100, 100+N) => secteur = cellId − 99 (base 1), azimuts dans l'ordre croissant ; hors plage, ou N inconnu : (cellId mod N) + 1",
      "sectorCount": "N = azimuts hors faisceau hertzien regroupés à 20° (bouclage 360°→0° compris)"
    },
    "bases": {
      "SFR": 1,
      "BOUYGUES": 1,
      "ORANGE": 1,
      "FREE": 1
    },
    "switched": "SECTOR-BASE-1 : SFR est servi en base 1 (S1..SN) ; les anciennes apps sont converties par le serveur"
  },
