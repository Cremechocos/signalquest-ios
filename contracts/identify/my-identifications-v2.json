{
  "contract": "my-identifications-v2",
  "doc": "docs/my-identifications-v2-contract.md",
  "route": "GET /api/android/map/identify/mine?v=2",
  "query": {
    "include": [
      "include=related",
      "include=posts,related",
      "include=posts&include=related"
    ],
    "limit": {
      "default": 200,
      "max": 400,
      "invalid": [
        "0",
        "-1",
        "1.5",
        "abc"
      ],
      "invalidCode": "INVALID_LIMIT"
    },
    "cursor": {
      "invalid": "pas-un-curseur",
      "invalidCode": "INVALID_CURSOR",
      "note": "valable seulement avec les mêmes operator, marketCode, include, conflict, siteId et enb/gnb ; sinon INVALID_CURSOR"
    },
    "conflict": {
      "values": [
        "only",
        "contested"
      ],
      "invalidCode": "INVALID_FILTER",
      "note": "nœuds seulement, jamais d'orphelines"
    },
    "siteId": {
      "example": "siteId=1234567",
      "rule": "égalité exacte avec le siteId stocké sur la ligne (pas de résolution d'alias ANFR) ; nœuds, leurs cellules et les orphelines de ce support ; totals sur ce support",
      "invalid": [
        "x × 65"
      ],
      "invalidCode": "INVALID_FILTER",
      "added": "2026-11-02"
    },
    "node": {
      "params": [
        "enb=…",
        "gnb=…"
      ],
      "rule": "chiffres seulement (1 à 12) ; un seul des deux ; la ligne nœud de cette valeur, les cellules qui la portent et ses orphelines ; cumulable avec siteId et les autres filtres",
      "invalid": [
        "enb=12a",
        "enb=1&gnb=2"
      ],
      "invalidCode": "INVALID_FILTER",
      "added": "2026-11-02"
    }
  },
  "response": {
    "v1": [
      "identifications",
      "truncated"
    ],
    "v2": [
      "identifications",
      "nextCursor",
      "truncated",
      "restartAdvised",
      "checks",
      "totals"
    ],
    "relatedMaxPerPage": 4000,
    "order": "createdAt décroissant puis id décroissant (createdAt ne change jamais ; lastValidated si)",
    "checks": {
      "conflict": [
        "ok",
        "unavailable"
      ],
      "cellConflict": [
        "ok",
        "unavailable"
      ],
      "sectorCheck": [
        "ok",
        "unavailable"
      ]
    },
    "totals": {
      "firstPageOnly": true,
      "keys": [
        "nodes",
        "enb",
        "gnb",
        "cellRows",
        "orphanRows",
        "conflicts",
        "contested"
      ],
      "nullable": [
        "conflicts",
        "contested"
      ],
      "ignoresConflictFilter": true,
      "rows": "cellRows et orphanRows comptent des LIGNES servies, pas des cellules distinctes : une app qui fusionne pci et cellid d'une même cellule affiche moins d'entrées et étiquette en conséquence. cellRows exclut les orphelines ; cellRows + orphanRows = toutes les lignes pci/cellid."
    },
    "lineFlags": {
      "orphan": "cellule sans ligne nœud active du membre (pages finales)",
      "cellsTruncated": "nœud dont seules les 4 000 cellules les plus récentes sont servies",
      "conflictStatus": "nœuds, v1 et v2 : ok | unavailable"
    },
    "orphanPages": {
      "ignoresLimit": true,
      "maxRows": 4000
    }
  },
