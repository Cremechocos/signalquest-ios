{
  "contract": "quality-scale",
  "version": "1.1",
  "status": "frozen",
  "decisions": [
    "01/10/2026, Alexandre : débits descendants sur 7 paliers jusqu'à 1 Gbit/s, seuils et teintes déjà communs aux trois plateformes.",
    "01/10/2026, Alexandre : signal sur 5 niveaux avec les teintes et l'interprétation d'Android (seuils propres à chaque technologie, « sans réseau constaté » distinct de « pas de mesure »).",
    "01/10/2026, Alexandre : générations et opérateurs avec les teintes du web (couleurs officielles des opérateurs, générations foncées pour un libellé blanc lisible).",
    "01/10/2026, Alexandre : teintes de bande communes, celles proposées par iOS et mesurées par le web (au moins 3:1 sur les surfaces des trois plateformes), et traits de génération éclaircis en sombre pour les graphiques ; gel de la v1.1."
  ],
  "darkVariants": "Points de carte : identiques au clair, comme dans la v1. Graphiques : les bandes et les traits de génération ont leur variante sombre (v1.1).",
  "signal": {
    "metricByTechnology": {
      "2G": "RSSI",
      "3G": "RSCP",
      "4G": "RSRP",
      "4G+": "RSRP",
      "5G": "SS-RSRP",
      "5G NSA": "SS-RSRP"
    },
    "thresholdsDbm": {
      "RSRP": [
        -80,
        -90,
        -100,
        -110
      ],
      "SS-RSRP": [
        -80,
        -90,
        -100,
        -110
      ],
      "RSCP": [
        -75,
        -85,
        -95,
        -105
      ],
      "RSSI": [
        -70,
        -80,
        -90,
        -100
