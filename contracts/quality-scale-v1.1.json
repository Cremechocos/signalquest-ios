      "EDGE": "2G"
    },
    "noServiceTechnologies": [
      "Aucun",
      "NONE",
      "NO SERVICE"
    ],
    "sentinelsDbm": {
      "any": {
        "equals": 0,
        "why": "Import iOS : CoreTelephony ne donne pas le RSRP."
      },
      "RSSI": {
        "atMost": -113,
        "why": "Plancher GSM."
      },
      "RSCP": {
        "atLeast": -24,
        "why": "Clamp UMTS (29 757 points en base exactement à −24)."
      },
      "RSRP": {
        "atMost": -140,
        "why": "Plancher LTE."
      },
      "SS-RSRP": {
        "atMost": -140,
        "why": "Plancher NR."
      }
    },
    "rounding": "arrondi(x) = plancher(x + 0,5), comme Math.round de JavaScript et de Java : −80,4 → −80 ; −80,5 → −80 ; −80,6 → −81. En Swift, ne PAS utiliser .rounded() (qui s'éloigne de zéro : −80,5 → −81) mais (x + 0.5).rounded(.down)."
  },
