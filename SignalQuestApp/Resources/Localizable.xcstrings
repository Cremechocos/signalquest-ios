    "Chaque maillon est mesuré depuis nos serveurs. Un saut muet ne répond pas aux sondes mais laisse passer le trafic : ce n’est pas une panne." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each hop is measured from our servers. A silent hop does not answer probes but still forwards traffic: it is not an outage."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque maillon est mesuré depuis nos serveurs. Un saut muet ne répond pas aux sondes mais laisse passer le trafic : ce n’est pas une panne."
          }
        }
      }
