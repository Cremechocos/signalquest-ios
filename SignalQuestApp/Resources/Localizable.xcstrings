    },
    "La file de mesures en attente ne peut pas être lue. Les données d’origine sont conservées ; réessaie plus tard." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending measurements cannot be read. Original data is preserved; try again later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La file de mesures en attente ne peut pas être lue. Les données d’origine sont conservées ; réessaie plus tard."
          }
        }
      }
    },
    "La force du signal 4G ou 5G reçu de l’antenne, en dBm. Plus le chiffre est proche de zéro, plus le signal est fort : −80 dBm vaut mieux que −110 dBm." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The strength of the 4G or 5G signal received from the antenna, in dBm. The closer to zero, the stronger: −80 dBm beats −110 dBm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La force du signal 4G ou 5G reçu de l’antenne, en dBm. Plus le chiffre est proche de zéro, plus le signal est fort : −80 dBm vaut mieux que −110 dBm."
          }
        }
      }
    },
    "La gestion E2EE v2 reste verrouillée jusqu’à la fin de la revue de sécurité." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E2EE v2 management stays locked until the security review is complete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La gestion E2EE v2 reste verrouillée jusqu’à la fin de la revue de sécurité."
          }
        }
      }
    },
    "La génération, pas le signal" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The generation, not the signal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération, pas le signal"
          }
        }
      }
    },
    "La hauteur totale de la structure qui porte les antennes — pylône, château d'eau, clocher, toit d'immeuble. Elle dépasse souvent la hauteur des antennes elles-mêmes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The total height of the structure carrying the antennas — mast, water tower, bell tower or rooftop. It is often higher than the antennas themselves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hauteur totale de la structure qui porte les antennes — pylône, château d'eau, clocher, toit d'immeuble. Elle dépasse souvent la hauteur des antennes elles-mêmes."
          }
        }
      }
    },
    "La hauteur à laquelle les antennes rayonnent, au-dessus du sol du site. C'est elle que vise la ligne de visée, et elle qui détermine jusqu'où le signal passe au-dessus des obstacles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The height at which the antennas radiate, above the ground at the site. This is the height targeted by the line of sight, and it determines how far the signal clears obstacles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hauteur à laquelle les antennes rayonnent, au-dessus du sol du site. C'est elle que vise la ligne de visée, et elle qui détermine jusqu'où le signal passe au-dessus des obstacles."
          }
        }
      }
    },
    "La liaison frôle un obstacle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The link passes close to an obstruction"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liaison frôle un obstacle"
          }
        }
      }
