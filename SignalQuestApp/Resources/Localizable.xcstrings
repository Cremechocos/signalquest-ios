    },
    "La localisation est désactivée pour SignalQuest. Active-la dans les Réglages pour situer tes mesures sur la carte. Le test fonctionne quand même sans." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location is turned off for SignalQuest. Turn it on in Settings to place your measurements on the map. The test still works without it."
          }
        },
        "fr" : {
          "stringUnit" : {
