    "Site relevé sur le terrain par un membre : sa position et ses identifiants viennent d'un relevé, pas d'un registre. Hauteur, secteurs et azimuts ne sont donc pas connus." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site surveyed in the field by a member: its position and identifiers come from a field reading, not a registry. Height, sectors and azimuths are therefore unknown."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site relevé sur le terrain par un membre : sa position et ses identifiants viennent d'un relevé, pas d'un registre. Hauteur, secteurs et azimuts ne sont donc pas connus."
          }
        }
      }
