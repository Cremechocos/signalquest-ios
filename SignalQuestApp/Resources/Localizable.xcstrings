    "Un Drive Test sert à cartographier le réseau. Ce que tu enregistres est publié sur la carte communautaire — c'est le principe, il n'y a pas de réglage pour l'en empêcher." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A drive test exists to map the network. What you record is published on the community map — that is the point, and there is no setting to prevent it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un Drive Test sert à cartographier le réseau. Ce que tu enregistres est publié sur la carte communautaire — c'est le principe, il n'y a pas de réglage pour l'en empêcher."
          }
        }
      }
    },
    "Un même pylône porte souvent plusieurs opérateurs. Coche celles qui sont sur le même support pour n'en faire qu'un site." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un même pylône porte souvent plusieurs opérateurs. Coche celles qui sont sur le même support pour n'en faire qu'un site."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single mast often hosts several operators. Select those on the same structure to combine them into one site."
          }
        }
      }
    },
