        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position et ton cap"
          }
        }
      }
    },
    "Ta position exacte n'est jamais publiée : chaque point est ramené sur une grille d'environ 50 m. Cela reste un déplacement identifiable à l'échelle du pâté de maisons — garde-le en tête avant de partir de chez toi." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your exact position is never published: each point is snapped to a grid of about 50 m. It remains a movement identifiable at the block level — keep that in mind before setting off from home."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position exacte n'est jamais publiée : chaque point est ramené sur une grille d'environ 50 m. Cela reste un déplacement identifiable à l'échelle du pâté de maisons — garde-le en tête avant de partir de chez toi."
          }
        }
      }
    },
    "Ta position n'est partagée que lorsque tu consultes la carte des amis." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is only shared while you're viewing the friends map."
