    "Sous tunnel, l'opérateur détecté est celui de la sortie du VPN : la mesure serait attribuée au mauvais réseau. Rien n'est alors ni enregistré ni publié." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Through a tunnel, the detected carrier is the VPN exit's: the measurement would be attributed to the wrong network. Nothing is recorded or published in that case."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous tunnel, l'opérateur détecté est celui de la sortie du VPN : la mesure serait attribuée au mauvais réseau. Rien n'est alors ni enregistré ni publié."
          }
        }
      }
    },
