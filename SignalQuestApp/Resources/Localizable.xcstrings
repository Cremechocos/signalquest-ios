            "value" : "La double authentification est déjà active."
          }
        }
      }
    },
    "La double authentification est déjà activée pour ce compte. Actualise son état." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two-factor authentication is already enabled for this account. Refresh its status."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La double authentification est déjà activée pour ce compte. Actualise son état."
          }
        }
      }
    },
    "La droite entre un observateur au point de départ et les antennes. Quand elle est dégagée, la liaison est dite « en visibilité directe » : c'est le cas le plus favorable. Sinon le signal doit contourner ou traverser, et perd beaucoup." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The straight line between an observer at the starting point and the antennas. When clear, the connection has a direct line of sight, which is the most favorable case. Otherwise, the signal must travel around or through obstacles and loses considerable strength."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La droite entre un observateur au point de départ et les antennes. Quand elle est dégagée, la liaison est dite « en visibilité directe » : c'est le cas le plus favorable. Sinon le signal doit contourner ou traverser, et perd beaucoup."
          }
        }
      }
    },
    "La droite passe, mais un obstacle entame la zone de Fresnel : le signal s'atténue sans être coupé." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The line is clear, but an obstruction enters the Fresnel zone: the signal weakens without being cut off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La droite passe, mais un obstacle entame la zone de Fresnel : le signal s'atténue sans être coupé."
          }
        }
      }
    },
    "La désactivation n’a pas pu être confirmée. Actualise le compte avant de réessayer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deactivation could not be confirmed. Refresh your account before trying again."
          }
        },
