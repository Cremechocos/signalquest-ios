    "Ta position disparaît automatiquement après environ 3 min sans mise à jour, et dès que tu coupes le partage." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location disappears automatically after about 3 min without an update, and as soon as you turn sharing off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position disparaît automatiquement après environ 3 min sans mise à jour, et dès que tu coupes le partage."
