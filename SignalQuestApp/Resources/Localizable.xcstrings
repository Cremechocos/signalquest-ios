    },
    "La propreté du signal reçu, en dB : elle baisse quand la cellule est chargée ou brouillée par ses voisines. Proche de zéro, c’est bon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How clean the received signal is, in dB: it drops when the cell is busy or disturbed by its neighbours. Close to zero is good."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La propreté du signal reçu, en dB : elle baisse quand la cellule est chargée ou brouillée par ses voisines. Proche de zéro, c’est bon."
          }
        }
      }
    },
    "La protection de tes zones privées est indisponible. Réessaie plus tard." : {
      "extractionState" : "manual",
