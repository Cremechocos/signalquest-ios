    "Sondage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poll"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sondage"
          }
        }
      }
    },
    "Sonde ICMP depuis nos serveurs, cinq paquets par salve, une salve par minute — accélérée à une toutes les dix secondes dès qu’un paquet manque, afin de dater une coupure à la dizaine de secondes près. IPv4 et IPv6 sont mesurées séparément ; %@ est réputée joignable dès qu’une des deux répond." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ICMP probes from our servers, five packets per burst and one burst per minute. As soon as a packet is missing, this increases to one burst every ten seconds to timestamp an outage within ten seconds. IPv4 and IPv6 are measured separately; %@ is considered reachable as soon as either one responds."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonde ICMP depuis nos serveurs, cinq paquets par salve, une salve par minute — accélérée à une toutes les dix secondes dès qu’un paquet manque, afin de dater une coupure à la dizaine de secondes près. IPv4 et IPv6 sont mesurées séparément ; %@ est réputée joignable dès qu’une des deux répond."
          }
        }
      }
    },
