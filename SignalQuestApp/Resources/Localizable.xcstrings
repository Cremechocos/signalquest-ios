    "La panne est terminée" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The outage is over"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La panne est terminée"
          }
        }
      }
    },
    "La part des données qui n’arrivent jamais et doivent être renvoyées. Au-delà de 1 pour cent, les appels coupent et les pages se bloquent." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The share of data that never arrives and has to be resent. Above 1 percent, calls drop and pages stall."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La part des données qui n’arrivent jamais et doivent être renvoyées. Au-delà de 1 pour cent, les appels coupent et les pages se bloquent."
          }
        }
      }
    },
    "La partie d’un site qui arrose une direction. Un pylône porte souvent trois secteurs, un tous les 120°." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The part of a site that covers one direction. A mast often carries three sectors, one every 120°."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partie d’un site qui arrose une direction. Un pylône porte souvent trois secteurs, un tous les 120°."
          }
        }
      }
    },
    "La plage de fréquences utilisée par une cellule, notée B en 4G et n en 5G. Les basses fréquences portent loin et traversent les murs ; les hautes offrent plus de débit sur une zone plus petite." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The frequency range a cell uses, written B in 4G and n in 5G. Low frequencies reach far and go through walls; high ones give more speed over a smaller area."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plage de fréquences utilisée par une cellule, notée B en 4G et n en 5G. Les basses fréquences portent loin et traversent les murs ; les hautes offrent plus de débit sur une zone plus petite."
          }
        }
      }
    },
    "La position est absente, trop ancienne ou trop imprécise. Elle sera acquise au démarrage." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The location is missing, too old or too inaccurate. It will be acquired when starting."
