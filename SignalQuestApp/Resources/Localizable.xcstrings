        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position n'est partagée que lorsque tu consultes la carte des amis."
          }
        }
      }
    },
    "Ta position reste partagée en continu tant que SignalQuest est ouverte, même sans consulter la carte des amis, ou pendant un Drive Test actif. Le partage se met en pause dès que l'app passe en arrière-plan." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location stays shared continuously while SignalQuest is open, even without viewing the friends map, or during an active Drive Test. Sharing pauses as soon as the app goes to the background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position reste partagée en continu tant que SignalQuest est ouverte, même sans consulter la carte des amis, ou pendant un Drive Test actif. Le partage se met en pause dès que l'app passe en arrière-plan."
