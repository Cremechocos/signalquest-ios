    "Surveille en continu une connexion, comme ta box, depuis nos serveurs : chaque minute, même téléphone éteint. Coupures, latence et incidents te sont signalés." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps watching a connection, such as your home router, from our servers: every minute, even with your phone off. Outages, latency and incidents are reported to you."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveille en continu une connexion, comme ta box, depuis nos serveurs : chaque minute, même téléphone éteint. Coupures, latence et incidents te sont signalés."
          }
        }
      }
