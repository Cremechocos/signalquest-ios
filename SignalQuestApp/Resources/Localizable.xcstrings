    },
    "La clé de récupération est créée sur cet appareil et n’est jamais conservée en clair par SignalQuest." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recovery key is created on this device and is never stored in plain text by SignalQuest."
