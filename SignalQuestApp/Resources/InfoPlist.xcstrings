    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest uses the camera only during video calls that you start or accept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest utilise la caméra uniquement pendant les appels vidéo que tu démarres ou acceptes."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest uses Face ID to lock the app and to unlock your encrypted messages."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest utilise Face ID pour verrouiller l'app et déverrouiller ta messagerie chiffrée."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest uses your location, if you allow it, to place your speedtests and contributions on the map, to track a Drive Test (including with the screen locked) and, if you turn it on, to share your live location with your friends."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest utilise ta position, si tu l'autorises, pour placer tes speedtests et contributions sur la carte, suivre un Drive Test (y compris écran verrouillé) et, si tu l'actives, partager ta position en direct avec tes amis."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest uses the microphone only during audio or video calls that you start or accept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest utilise le micro uniquement pendant les appels audio ou vidéo que tu démarres ou acceptes."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest can import a photo you choose, to contribute to antenna sites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalQuest peut importer une photo choisie pour contribuer aux sites antennes."
          }
        }
      }
    }
