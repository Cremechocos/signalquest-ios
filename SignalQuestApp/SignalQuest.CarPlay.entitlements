<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(SQ_APS_ENVIRONMENT)</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>$(SQ_ASSOCIATED_DOMAIN)</string>
		<string>$(SQ_APPLINKS_DOMAIN)</string>
	</array>
	<!-- Catégorie CarPlay « navigation ». UNE SEULE catégorie par app : Apple
	     n'accorde pas `carplay-maps` et `carplay-driving-task` ensemble, et c'est
	     `-maps` qui donne CPMapTemplate (notre MKMapView plein écran), la
	     CPNavigationSession du guidage et la scène Dashboard.

	     ⚠️ Tant qu'Apple n'a pas accordé l'entitlement sur le compte développeur
	     ET activé la capacité sur l'App ID, cette clé fait ÉCHOUER la signature
	     automatique de tout build appareil ou archive. Ce fichier est donc réservé
	     aux builds simulateur, via SQ_ENTITLEMENTS (cf. Config/*.xcconfig) : le
	     simulateur n'exige aucun accord, seulement la présence de la clé.

	     Jour de l'accord : activer la capacité sur fr.signalquest.ios ET
	     fr.signalquest.ios.beta, basculer Staging.xcconfig et Release.xcconfig sur
	     ce fichier, puis supprimer SignalQuest.entitlements. -->
	<key>com.apple.developer.carplay-maps</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SQ_APP_GROUP)</string>
	</array>
</dict>
</plist>
